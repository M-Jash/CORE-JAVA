import java.util.Arrays;

public class StringMethods {
    public static void main(String[] args) {

        String obj = "vamshi";
        String str = "vamshi";

        System.out.println(obj + " " + str);

        String obj1 = new String("vamshi 1");

        System.out.println(obj1.length());

        System.out.println(obj1.toUpperCase());

        System.out.println(obj1.toLowerCase());

        System.out.println(obj1.trim());

        System.out.println(obj1.replace('v', 'V'));

        System.out.println(obj1.charAt(2));

        System.out.println(obj1.indexOf('a'));

        System.out.println(obj1.substring(2, 5));

        System.out.println(String.valueOf(3));

        System.out.println(obj1.strip());

        System.out.println(obj1.isEmpty());

        System.out.println(obj1.equals("vamshi 1"));

        System.out.println(obj1.equalsIgnoreCase("VAMSHI 1"));

        System.out.println(obj1.compareTo("vamshi 1"));

        System.out.println(obj1.compareToIgnoreCase("VAMSHI 1"));

        System.out.println(obj1.startsWith("vam"));

        System.out.println(obj1.endsWith("1"));

        System.out.println(obj1.contains("msh"));

        System.out.println(Arrays.toString(obj1.split(" ")));

        System.out.println(obj1.replaceAll("vamshi 1", "VAMSHI"));

        System.out.println(obj1.replaceFirst("vamshi 1", "VAMSHI"));

        System.out.println(obj1.matches("vamshi 1"));
    }
}

