import java.util.*;

class Mits {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        String str = sc.nextLine();
        String o = "hi";

        System.out.println(o + " " + str);

        String o1 = "linges";

        for (int i = 0; i < o1.length(); i++) {
            System.out.println(o1.charAt(i));
        }

        System.out.println(o1.length());
        System.out.println(o1.toUpperCase());
        System.out.println(o1.toLowerCase());
        System.out.println(o1.trim());

        sc.close();
    }
}
